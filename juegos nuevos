// --- Juegos por nivel (1.º–2.º, 3.º–4.º y 5.º–6.º) ---
// Reglas para que ningún juego regale la respuesta:
//  - el enunciado nunca contiene la respuesta (las pistas se muestran SOLO después de contestar);
//  - las imágenes de las opciones no llevan texto (el nombre aparece al responder);
//  - las opciones se mezclan al jugar (ver prepareQuestion en game-player.tsx).
const IMG = '/games/ref/'

const FAMILY = ['mum', 'dad', 'grandma', 'grandpa', 'sister', 'brother', 'auntie']
function familyQuestion(id: string, target: string, others: string[]): Question {
  const names = [target, ...others]
  return {
    id,
    prompt: `Listen and tap: ${target}`,
    speak: target,
    options: names,
    optionImages: names.map((n) => `${IMG}family-${n}.png`),
    answerIndex: 0,
  }
}

const BODY_PARTS = ['head', 'arm', 'hand', 'body', 'leg', 'foot']
function bodyQuestion(id: string, part: string): Question {
  return {
    id,
    prompt: `Tap the ${part}.`,
    speak: part,
    options: BODY_PARTS,
    answerIndex: BODY_PARTS.indexOf(part),
    bodyPart: true,
    keepOrder: true,
  }
}

function sizeQuestion(id: string, item: string, ask: 'big' | 'small'): Question {
  return {
    id,
    prompt: ask === 'big' ? 'Tap the BIG one.' : 'Tap the SMALL one.',
    speak: ask,
    options: ['big', 'small'],
    optionImages: [`${IMG}${item}-big.png`, `${IMG}${item}-small.png`],
    answerIndex: ask === 'big' ? 0 : 1,
  }
}

function lengthQuestion(id: string, item: string, ask: 'short' | 'long'): Question {
  return {
    id,
    prompt: ask === 'long' ? `Which ${item} is LONG?` : `Which ${item} is SHORT?`,
    speak: ask,
    options: ['short', 'long'],
    optionImages: [`${IMG}short-${item}.svg`, `${IMG}long-${item}.svg`],
    optionLayout: 'stack',
    answerIndex: ask === 'long' ? 1 : 0,
  }
}

const FOOD = ['apple', 'burger', 'broccoli', 'fries', 'ice cream', 'fish']
const FOOD_IMG: Record<string, string> = {
  apple: `${IMG}food-apple.png`,
  burger: `${IMG}food-burger.png`,
  broccoli: `${IMG}food-broccoli.png`,
  fries: `${IMG}food-fries.png`,
  'ice cream': `${IMG}food-icecream.png`,
  fish: `${IMG}food-fish.png`,
}
function foodQuestion(id: string, prompt: string, options: string[], correct: string[], hint?: string): Question {
  const multi = correct.length > 1
  return {
    id,
    prompt,
    options,
    optionImages: options.map((o) => FOOD_IMG[o]),
    ...(multi
      ? { answerIndexes: correct.map((c) => options.indexOf(c)) }
      : { answerIndex: options.indexOf(correct[0]) }),
    hint,
  }
}

const ANIMAL_IMG: Record<string, string> = {
  dog: `${IMG}animal-dog.png`,
  cat: `${IMG}animal-cat.png`,
  rabbit: `${IMG}animal-rabbit.png`,
  bird: `${IMG}animal-bird.png`,
}
function animalChoice(id: string, prompt: string, options: string[], correct: string, speak?: string): Question {
  return {
    id,
    prompt,
    speak,
    options,
    optionImages: options.map((o) => ANIMAL_IMG[o]),
    answerIndex: options.indexOf(correct),
  }
}

const CAN_OPTIONS = ['can', 'can’t']
function canQuestion(id: string, image: string, prompt: string, can: boolean): Question {
  return { id, prompt, image, options: CAN_OPTIONS, answerIndex: can ? 0 : 1, keepOrder: true }
}

