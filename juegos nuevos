const SHORTS = '#1E3A8A'
const SHOES = '#E5533D'
const HAIR = '#6B3F1D'

/** Devuelve un índice válido dentro de [0, length) o -1 si el valor no sirve. */
function validIndex(value: number | null | undefined, length: number): number {
  return typeof value === 'number' && Number.isInteger(value) && value >= 0 && value < length ? value : -1
}

/** Dibujo del cuerpo donde se toca la parte pedida. No marca nada hasta que se responde. */
export function BodyQuestion({
  question,
  selected,
  answered,
  onSelect,
}: {
  question: Question
  selected: number | null
  answered: boolean
  onSelect: (index: number) => void
}) {
  const parts = (Array.isArray(question.options) ? question.options : []) as Part[]
  // Índices validados: si answerIndex o selected no son enteros dentro del rango, no se marca nada.
  const correctIndex = validIndex(question.answerIndex, parts.length)
  const correctPart = correctIndex >= 0 ? parts[correctIndex] : undefined
  const selectedIndex = validIndex(selected, parts.length)
  const selectedPart = selectedIndex >= 0 ? parts[selectedIndex] : undefined

  function select(part: Part) {
    if (answered) return
    const index = parts.indexOf(part)
    if (index < 0) return // la parte no está en las opciones: nunca enviamos un -1
    onSelect(index)
  }

  function stroke(part: Part) {
    if (!answered) return { stroke: 'transparent', strokeWidth: 0 }
    if (part === correctPart) return { stroke: '#16a34a', strokeWidth: 6 }
    if (part === selectedPart) return { stroke: '#dc2626', strokeWidth: 6 }
    return { stroke: 'transparent', strokeWidth: 0 }
