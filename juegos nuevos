function shuffleIndexes(n: number): number[] {
  const a = Array.from({ length: n }, (_, i) => i)
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1))
    ;[a[i], a[j]] = [a[j], a[i]]
  }
  return a
}

/**
 * Mezcla las opciones para que la respuesta correcta no esté siempre en la misma posición.
 * No mezcla verdadero/falso, can / can’t ni las partes del cuerpo (keepOrder / bodyPart).
 */
function prepareQuestion(activity: Activity, q: Question): Question {
  if (!q.options || q.options.length < 2) return q
  if (q.keepOrder || q.bodyPart || activity.type === 'true-false') return q
  const order = shuffleIndexes(q.options.length)
  return {
    ...q,
    options: order.map((i) => q.options![i]),
    optionImages: q.optionImages ? order.map((i) => q.optionImages![i]) : undefined,
    answerIndex: q.answerIndex !== undefined ? order.indexOf(q.answerIndex) : undefined,
    answerIndexes: q.answerIndexes ? q.answerIndexes.map((a) => order.indexOf(a)) : undefined,
  }
}

type Kind = 'choice' | 'body' | 'text' | 'order' | 'match' | 'memory'

function kindOf(activity: Activity, q: Question): Kind {
  if (q.pairs) return activity.type === 'memory' ? 'memory' : 'match'
  if (q.sequence) return 'order'
  if (q.answer !== undefined) return 'text'
  if (q.bodyPart) return 'body'
  return 'choice'
}

export function GamePlayer({ activity }: { activity: Activity }) {
  const { student } = useSession()
  // La key remonta el juego si cambia el alumno o la actividad. Así el estado de la partida
  // y `todayCompleted` se recalculan siempre y nunca quedan viejos.
  return <GamePlayerSession key={`${student.id}:${activity.id}`} activity={activity} />
}

