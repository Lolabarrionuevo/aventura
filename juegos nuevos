  const [selected, setSelected] = useState<number | null>(null)
  const [selectedMulti, setSelectedMulti] = useState<number[]>([])
  const [textValue, setTextValue] = useState('')
  const [orderChosen, setOrderChosen] = useState<number[]>([])
  const [answered, setAnswered] = useState(false)
  const [lastCorrect, setLastCorrect] = useState(false)

  const startRef = useRef(Date.now())
  const finishedRef = useRef(false)
  // Fuente de verdad de los aciertos: un ref no queda "viejo" entre renders (a diferencia del estado).
  const correctCountRef = useRef(0)
  const total = activity.questions.length
  const rawQuestion = activity.questions[index]
  // Las opciones se mezclan una sola vez por pregunta.
  const question = useMemo(() => prepareQuestion(activity, rawQuestion), [activity.id, index]) // eslint-disable-line react-hooks/exhaustive-deps
  const kind = kindOf(activity, question)
  const isMulti = kind === 'choice' && Array.isArray(question.answerIndexes)

  // Temporizador para quiz contra reloj
  const [timeLeft, setTimeLeft] = useState(activity.timeLimitSec ?? 0)
  const isTimed = activity.type === 'timed-quiz' && (activity.timeLimitSec ?? 0) > 0

  useEffect(() => {
    if (!isTimed || done) return
    if (timeLeft <= 0) {
      // Se acabó el tiempo: cierra la partida con los aciertos reales (ref), no con el estado del render.
      finish(correctCountRef.current)
      return
    }
    const t = setTimeout(() => setTimeLeft((v) => v - 1), 1000)
    return () => clearTimeout(t)
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [timeLeft, isTimed, done])

  function finish(finalCorrect: number) {
    if (finishedRef.current) return
    finishedRef.current = true
    const timeSec = Math.round((Date.now() - startRef.current) / 1000)
    const { score, xpEarned } = scoreActivity({
      correctCount: finalCorrect,
      totalCount: total,
      timeSec,
      timeLimitSec: activity.timeLimitSec,
      baseXpReward: activity.xpReward,
    })
    const rewardKey = `adventure-reward:${student.id}:${activity.id}`
    const alreadyRewarded = localStorage.getItem(rewardKey) === '1'
    const awardedXp = alreadyRewarded ? 0 : xpEarned
    if (!alreadyRewarded) localStorage.setItem(rewardKey, '1')
    if (!alreadyRewarded && finalCorrect === total) setCelebrate(true)
    if (!alreadyRewarded) {
      recordCompletion({
        id: `${student.id}-${activity.id}-${Date.now()}`,
        studentId: student.id,
        activityId: activity.id,
        correctCount: finalCorrect,
        totalCount: total,
        timeSec,
        score,
        xpEarned: awardedXp,
        date: new Date().toISOString(),
      })
    }
    const updatedStudent = { ...student, xp: student.xp + awardedXp }
    const earnedNow = newlyEarnedBadges(updatedStudent, activity.id, score)
    if (earnedNow.length > 0) {
      updatedStudent.badgeIds = [...updatedStudent.badgeIds, ...earnedNow.map((badge) => badge.id)]
      setNewBadges(earnedNow.map((badge) => badge.name))
    }
    setStudent(updatedStudent)
    setResult({ score, xpEarned: awardedXp, timeSec })
    setDone(true)
  }

  function registerCorrect() {
    correctCountRef.current += 1
    setCorrectCount(correctCountRef.current)
  }

  // La validación real de cada respuesta vive aquí; los componentes solo informan qué eligió la persona.
  function commitChoice(i: number) {
    if (answered) return
    if (!Number.isInteger(i) || i < 0 || i >= (question.options?.length ?? 0)) return
    setSelected(i)
    const correct = i === question.answerIndex
    setLastCorrect(correct)
    setAnswered(true)
    if (correct) registerCorrect()
  }

  function toggleMulti(i: number) {
    if (answered) return
    setSelectedMulti((prev) => (prev.includes(i) ? prev.filter((v) => v !== i) : [...prev, i]))
  }

  function commitMulti() {
    if (answered || selectedMulti.length === 0) return
    const expected = [...(question.answerIndexes ?? [])].sort((a, b) => a - b)
    const given = [...selectedMulti].sort((a, b) => a - b)
    const correct = expected.length === given.length && expected.every((v, k) => v === given[k])
    setLastCorrect(correct)
    setAnswered(true)
    if (correct) registerCorrect()
  }

  function commitText() {
    if (answered || !textValue.trim()) return
    const correct =
      textValue.trim().toLowerCase() === (question.answer ?? '').trim().toLowerCase()
    setLastCorrect(correct)
    setAnswered(true)
    if (correct) registerCorrect()
  }

  function chooseOrder(i: number) {
    if (answered) return
    const next = [...orderChosen, i]
    setOrderChosen(next)
    if (next.length === (question.sequence?.length ?? 0)) {
      const correct = next.every((v, pos) => v === pos)
      setLastCorrect(correct)
      setAnswered(true)
      if (correct) registerCorrect()
    }
  }

  function settleInteractive(valid: boolean) {
    if (answered) return
    setLastCorrect(valid)
    setAnswered(true)
    if (valid) registerCorrect()
  }

  // match-concepts: cada elemento de la izquierda debe estar unido a SU pareja correcta.
  function completeMatch(matched: Record<string, string>) {
    const pairs = question.pairs ?? []
    const valid =
      pairs.length > 0 &&
      Object.keys(matched ?? {}).length === pairs.length &&
      pairs.every((p) => matched[p.left] === p.right)
    settleInteractive(valid)
  }

  // memory: tienen que estar encontradas TODAS las parejas (p-0, p-1, ...), sin faltar ni repetirse.
  function completeMemory(foundPairKeys: string[]) {
    const pairs = question.pairs ?? []
    const found = new Set(foundPairKeys ?? [])
    const valid = pairs.length > 0 && found.size === pairs.length && pairs.every((_, i) => found.has(`p-${i}`))
    settleInteractive(valid)
  }

  function next() {
    if (index + 1 >= total) {
      finish(correctCountRef.current)
      return
    }
    setIndex((i) => i + 1)
    setSelected(null)
    setSelectedMulti([])
    setTextValue('')
    setOrderChosen([])
    setAnswered(false)
    setLastCorrect(false)
  }

  if (todayCompleted && !done) {
    return (
      <ActivityResultScreen
        activity={activity}
        correctCount={todayCompleted.correctCount}
        total={todayCompleted.totalCount}
        score={todayCompleted.score}
        xpEarned={0}
        timeSec={todayCompleted.timeSec}
        onRetry={() => window.location.reload()}
        alreadyCompleted
      />
    )
  }

  if (done && result) {
    return (
      <ActivityResultScreen
        activity={activity}
        correctCount={correctCount}
        total={total}
        score={result.score}
        xpEarned={result.xpEarned}
        timeSec={result.timeSec}
        onRetry={() => window.location.reload()}
        newBadges={newBadges}
      />
    )
